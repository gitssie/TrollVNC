<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>

	<!-- The only entitlement that actually opens the door. appstored's service catalog gates the
	     purchase and purchase-history services on this one; every com.apple.appstored.* entitlement
	     returns ASDErrorDomain 505 instead. Verified by bisecting one entitlement at a time. -->
	<key>com.apple.itunesstored.private</key>
	<true/>

	<!-- `login`. +[SSAuthenticateRequest _isAuthkitEntitled] returns YES for either of these, and
	     without one the request is shipped to itunesstored over XPC rather than run in process, so
	     a two-factor challenge can be neither presented nor answered. -->
	<key>com.apple.authkit.client.private</key>
	<true/>
	<key>com.apple.authkit.client.internal</key>
	<true/>

	<!-- `logout`. -[ACDAccountStoreFilter _isClientPermittedToRemoveAccount:] in accountsd allows
	     a removal on a type-independent entitlement, one of two type-specific ones, or the client
	     owning the account. We never own an account created through SSAuthenticateRequest. This is
	     the type-independent one, bisected on device; without it accountsd answers
	     com.apple.accounts code 7. -->
	<key>com.apple.private.accounts.allaccounts</key>
	<true/>

	<!-- `versions`. Asking the store for an app's version list goes through AMSPurchaseQueue in
	     this process rather than through appstored, and the store will not answer without anisette
	     attestation. Without these two the request reaches p26-buy.itunes.apple.com, gets HTTP 200,
	     and comes back AMSErrorDomain 307 "Anisette Provisioning Failed" / AMSAnisetteErrorCode
	     -45002 — the machine data could not be produced.

	     ADI keeps its provisioning in the keychain under the `apple` access group, which a binary
	     with no keychain-access-groups at all cannot reach. Both values are copied from Apple's own
	     asclient (com.apple.asclient), which does the same in-process lookup. -->
	<key>adi-client</key>
	<string>409835401</string>
	<key>keychain-access-groups</key>
	<array>
		<string>apple</string>
	</array>
</dict>
</plist>
