# Copy this file to TrollVNC/.deploy/deploy.env after creating .deploy with
# mode 700. Replace every placeholder, then chmod deploy.env to 600.

TROLLVNC_SILEO_SOURCE_URL="http://127.0.0.1:<device-port>/"
TROLLVNC_SILEO_HTTP_PORT="<mac-loopback-port>"
TROLLVNC_SILEO_DEVICE_PORT="<device-port>"
TROLLVNC_SILEO_SSH_HOST="<existing-ssh-or-iproxy-host>"
TROLLVNC_SILEO_SSH_PORT="<existing-ssh-or-iproxy-port>"
TROLLVNC_SILEO_SSH_USER="mobile"
TROLLVNC_SILEO_SSH_IDENTITY="/absolute/path/to/authorized-mobile-private-key"

# Optional. Normally the source-derived current package is selected. An
# override must be absolute and point directly inside TrollVNC/packages.
# TROLLVNC_SILEO_PACKAGE="/absolute/path/to/TrollVNC/packages/current-arm64e.deb"
